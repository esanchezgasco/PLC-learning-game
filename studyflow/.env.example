# --- StudyFlow: configuració opcional de la capa d'IA (servidor) ---
# Sense cap clau, l'aplicació funciona en mode local (sense IA).
# Les claus NO s'exposen mai al navegador.

# Proveïdor per defecte: anthropic | openai-compatible
AI_PROVIDER=anthropic

# Anthropic (Claude)
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# Proveïdor compatible amb l'API d'OpenAI (opcional; p. ex. un servidor local)
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=

# Llista de models que l'usuari pot triar des de la configuració (separats per comes)
AI_ALLOWED_MODELS=claude-opus-5-5,claude-sonnet-5-5,claude-haiku-5-5

# Límits i control de costos
AI_MAX_INPUT_CHARS=60000
AI_MAX_OUTPUT_TOKENS=16000
AI_RATE_LIMIT_PER_MIN=10
AI_MAX_REQUESTS_PER_DAY=200

# Port del servidor de producció (npm start)
PORT=8787
